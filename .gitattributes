# Normalise line endings for text
* text=auto

# Godot text formats: keep LF so diffs stay clean
*.gd        text eol=lf
*.tscn      text eol=lf
*.tres      text eol=lf
*.godot     text eol=lf
*.cfg       text eol=lf
*.import    text eol=lf
*.gdshader  text eol=lf
*.md        text eol=lf

# Binary assets are small enough to live in Git directly (no Git LFS).
# If large files (over ~50 MB) are ever added, set up Git LFS for them.
*.glb binary
*.bin binary
*.ogg binary
*.jpg binary
*.png binary
