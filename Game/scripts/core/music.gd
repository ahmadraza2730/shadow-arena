extends Node
## Music (autoload)
##
## Plays the menu or match loop and cross-fades between them. The tracks
## are original compositions generated by MapSource/gen_music.py.
## Volume follows Settings > Music volume (on its own "Music" audio bus,
## so it is independent of the effects volume).

const TRACKS := {
	"menu": "res://assets/music/menu_theme.ogg",
	"match": "res://assets/music/match_theme.ogg",
}
const FADE_TIME := 1.5
## The match track sits a little under the gunfire.
const TRACK_GAIN := {"menu": 0.0, "match": -5.0}

var _players: Array[AudioStreamPlayer] = []
var _active := 0
var _current := ""
var _bus := 0


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_bus = AudioServer.bus_count
	AudioServer.add_bus(_bus)
	AudioServer.set_bus_name(_bus, "Music")
	AudioServer.set_bus_send(_bus, "Master")
	for i in 2:
		var player := AudioStreamPlayer.new()
		player.bus = "Music"
		player.volume_db = -80.0
		add_child(player)
		_players.append(player)
	Game.settings_changed.connect(_apply_volume)
	_apply_volume()


## Switches to "menu", "match" or "" (silence), fading over FADE_TIME.
func play(track: String) -> void:
	if track == _current:
		return
	_current = track
	var old := _players[_active]
	_active = 1 - _active
	var new := _players[_active]
	var fade := create_tween().set_parallel(true)
	fade.tween_property(old, "volume_db", -80.0, FADE_TIME)
	fade.chain().tween_callback(old.stop)
	if track == "" or not TRACKS.has(track):
		return
	var stream: AudioStream = load(TRACKS[track])
	if stream is AudioStreamOggVorbis:
		(stream as AudioStreamOggVorbis).loop = true
	new.stream = stream
	new.volume_db = -40.0
	new.play()
	create_tween().tween_property(new, "volume_db", float(TRACK_GAIN[track]), FADE_TIME)


func _apply_volume() -> void:
	var volume := float(Game.settings.get("music_volume", 0.5))
	AudioServer.set_bus_mute(_bus, volume <= 0.001)
	AudioServer.set_bus_volume_db(_bus, linear_to_db(maxf(volume, 0.0001)))
